generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  poster
  ilustrasi
  branding
  uiux
}

model Design {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    Category @default(poster)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("designs")
}